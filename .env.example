# Server Configuration (Local Development)
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:5173

# Supabase Configuration (NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=student-documents

# Authentication (JWT)
JWT_SECRET=replace-with-a-strong-256-bit-secret
JWT_EXPIRES_IN=8h

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10

# Frontend API URL (for local dev; on Vercel same-origin /api is used automatically)
VITE_API_BASE_URL=http://localhost:5001/api

